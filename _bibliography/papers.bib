@article{park2026lbedit,
  title={Look Before You Edit: Attention-Guided Camera Placement and Multi-View Alignment for {3D} Gaussian Splatting Editing},
  author={Park, Jaeyeon and Kang, Taeho and Lee, Youngki},
  journal={arXiv preprint arXiv:2607.19777},
  year={2026},
  abbr={arXiv},
  abstract={Text-driven 3D scene editing with 3D Gaussian Splatting typically applies a 2D diffusion editor to views rendered from fixed training cameras, limiting both the spatial coverage of edits and the user's freedom to target specific objects in complex scenes. We present LB-Edit, a framework that addresses two coupled problems: where to place editing cameras for localized edits, and how to make per-view edits agree with one another so that the 3D scene remains consistent after fine-tuning. ACP probes the diffusion model's self- and cross-attention to find the attention-optimal camera distance, while MAA jointly synchronizes self- and cross-attention across views, suppressing appearance and spatial drift. Our method achieves the highest user preference in instruction fidelity, multi-view consistency, and editing locality using as few as 5 editing views, reducing latency by up to 7× over existing methods.},
  html={http://localhost:8787/},
  arxiv={2607.19777},
  selected={true}
}

@inproceedings{kang2025cem4dgs,
  title={Clustered Error Correction with Grouped {4D} Gaussian Splatting},
  author={Kang, Taeho and Park, Jaeyeon and Lee, Kyungjin and Lee, Youngki},
  booktitle={SIGGRAPH Asia 2025 Conference Papers},
  year={2025},
  abbr={SIGGRAPH Asia},
  abstract={We advance dynamic 3D scene reconstruction and novel view synthesis by building on 4D Gaussian Splatting. We develop error-correction and grouping techniques to improve reconstruction quality of moving objects over time, achieving state-of-the-art perceptual rendering quality on standard benchmarks.},
  html={https://tho-kn.github.io/projects/CEM-4DGS/},
  selected={true}
}

@inproceedings{park2024ondevice3dgs,
  title={Towards On-Device {3D} Gaussian Splatting},
  author={Park, Jaeyeon and Lee, Kyungjin and Jung, Hyunwoo and Lee, Youngki},
  booktitle={MobiSys 2024 Workshop},
  year={2024},
  abbr={MobiSys WS},
  abstract={We introduce the first mobile benchmark for 3D Gaussian Splatting, focusing on real-time rendering on mobile devices. We contribute mobile GPU adaptations including migrating from CUDA to OpenCL and Metal, reducing rendering time by 3× and memory usage by 20% compared to the original implementation.},
  selected={true}
}
